@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_@PROJECT_NAME@_PACKAGE_PREFIX_DIR "${PACKAGE_PREFIX_DIR}")
find_dependency(Eigen3 REQUIRED)
find_dependency(romea_core_common REQUIRED)
set(PACKAGE_PREFIX_DIR "${_@PROJECT_NAME@_PACKAGE_PREFIX_DIR}")
unset(_@PROJECT_NAME@_PACKAGE_PREFIX_DIR)

set(@PROJECT_NAME@_FOUND ON)
set_and_check(@PROJECT_NAME@_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include")
set_and_check(@PROJECT_NAME@_LIBRARY_DIRS "${PACKAGE_PREFIX_DIR}/lib")
set(@PROJECT_NAME@_LIBRARIES "romea_core_rtls::romea_core_rtls")
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
check_required_components("@PROJECT_NAME@")
